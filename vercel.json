{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/about", "destination": "/chi-siamo", "permanent": true },
    { "source": "/contact", "destination": "/contatti", "permanent": true },
    { "source": "/products", "destination": "/prodotti", "permanent": true },
    { "source": "/products/:id", "destination": "/prodotti/:id", "permanent": true }
  ],
  "rewrites": [
    { "source": "/prodotti/:id", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
