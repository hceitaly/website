# Pannello prodotti (/admin) — su Vercel vanno in Settings > Environment
# Variables; in locale copia questo file in .env.local e compilalo.
# .env.local non entra nel repository.

# Chi entra nel pannello.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Firma il cookie di sessione: stringa casuale lunga, almeno 16 caratteri.
# Cambiandola si scollegano tutte le sessioni aperte.
SESSION_SECRET=

# Token con cui il server scrive i contenuti nel repository.
# Fine-grained personal access token dell'account proprietario, limitato a
# questo repository, permesso "Contents: Read and write".
GITHUB_TOKEN=

# Facoltativi: servono solo per scostarsi da questi valori.
# GITHUB_REPO=hceitaly/website
# GITHUB_BRANCH=main
